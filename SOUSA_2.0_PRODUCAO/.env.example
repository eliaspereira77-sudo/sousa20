# SOUSA 2.0 - Variáveis de ambiente

# Obrigatória para o Gemini
GEMINI_API_KEY=sua_chave_aqui

# Opcional - OmniRoute (prioridade $0)
OMNIROUTE_BASE_URL=http://localhost:20128
OMNIROUTE_API_KEY=local
OMNIROUTE_MODEL=auto/cheap

# Opcional - TTS Piper (voz local)
PIPER_BIN=piper
PIPER_MODEL=/caminho/para/pt_BR-model.onnx
TTS_VOICE=pt_BR

# Servidor
PORT=5000
FLASK_DEBUG=false
